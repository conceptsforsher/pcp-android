<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipChildren="false"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="12dp">

    <Space
        android:id="@+id/loginSplashSpace1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/loginSplashLogoContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_constraintVertical_weight="1" />

    <LinearLayout
        android:id="@+id/loginSplashLogoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/loginSplashSpace2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginSplashSpace1">

        <ImageView
            android:id="@+id/loginSplashLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/element_logo_green"
            android:transitionName="loginLogoTransition" />

        <TextView
            android:id="@+id/logoType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Progressive Chat"
            android:textColor="?colorSecondary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Space
        android:id="@+id/loginSplashSpace2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/loginSplashTitle"
        app:layout_constraintTop_toBottomOf="@id/loginSplashLogoContainer"
        app:layout_constraintVertical_weight="0" />

    <TextView
        android:id="@+id/loginSplashTitle"
        style="@style/Widget.Vector.TextView.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/login_splash_title"
        android:textColor="?vctr_content_primary"
        android:textStyle="bold"
        android:transitionName="loginTitleTransition"
        app:layout_constraintBottom_toTopOf="@id/protocolSectionLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginSplashSpace2" />

    <TextView
        android:id="@+id/protocolSectionLabel"
        style="@style/Widget.Vector.TextView.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/protocol_section_label"
        android:textColor="?vctr_content_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/categoryChips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginSplashTitle" />

    <!-- Category toggle -->
    <LinearLayout
        android:id="@+id/categoryChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/groupDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/protocolSectionLabel">

        <TextView
            android:id="@+id/chipOpenSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_protocol_chip_selected"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/category_open_source"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipProprietary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_protocol_chip"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/category_proprietary"
            android:textColor="?vctr_content_primary"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/groupDescription"
        style="@style/Widget.Vector.TextView.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/open_source_group_desc"
        android:textColor="?vctr_content_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/protocolCards"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryChips" />

    <!-- Protocol cards — all defined statically, visibility toggled in fragment -->
    <LinearLayout
        android:id="@+id/protocolCards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/loginSplashFeatures"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/groupDescription">

        <!-- Matrix -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMatrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:checkable="true"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?vctr_system"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="?vctr_content_quaternary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/cardMatrixIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chat"
                    app:tint="?vctr_content_quaternary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cardMatrixTitle"
                        style="@style/Widget.Vector.TextView.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_matrix"
                        android:textColor="?vctr_content_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/cardMatrixDesc"
                        style="@style/Widget.Vector.TextView.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_matrix_desc"
                        android:textColor="?vctr_content_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioMatrix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- IRC -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIrc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:checkable="true"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?vctr_system"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="?vctr_content_quaternary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/cardIrcIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_login_splash_message_circle"
                    app:tint="?vctr_content_quaternary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cardIrcTitle"
                        style="@style/Widget.Vector.TextView.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_irc"
                        android:textColor="?vctr_content_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/cardIrcDesc"
                        style="@style/Widget.Vector.TextView.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_irc_desc"
                        android:textColor="?vctr_content_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioIrc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- XMPP (stub) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardXmpp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:alpha="0.4"
            android:clickable="false"
            android:focusable="false"
            app:cardBackgroundColor="?vctr_system"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="?vctr_content_quaternary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chat"
                    app:tint="?vctr_content_quaternary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_xmpp"
                        android:textColor="?vctr_content_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coming_soon"
                        android:textColor="?vctr_content_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Delta Chat (stub) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDelta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:alpha="0.4"
            android:clickable="false"
            android:focusable="false"
            app:cardBackgroundColor="?vctr_system"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="?vctr_content_quaternary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_login_splash_message_circle"
                    app:tint="?vctr_content_quaternary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_delta"
                        android:textColor="?vctr_content_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coming_soon"
                        android:textColor="?vctr_content_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Telegram (stub, proprietary category) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:alpha="0.4"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:cardBackgroundColor="?vctr_system"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="?vctr_content_quaternary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chat"
                    app:tint="?vctr_content_quaternary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_telegram"
                        android:textColor="?vctr_content_primary"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol_telegram_desc"
                        android:textColor="?vctr_content_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Features -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loginSplashFeatures"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@id/loginSplashSpace4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/protocolCards">

        <ImageView
            android:id="@+id/loginSplashPicto1"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_login_splash_message_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/loginSplashText1"
            app:tint="?vctr_content_secondary"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/loginSplashText1"
            style="@style/Widget.Vector.TextView.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="start"
            android:text="@string/login_splash_text1"
            android:textColor="?vctr_content_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@id/loginSplashText2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/loginSplashPicto1"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/loginSplashPicto2"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_login_splash_lock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/loginSplashText2"
            app:tint="?vctr_content_secondary"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/loginSplashText2"
            style="@style/Widget.Vector.TextView.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="6dp"
            android:gravity="start"
            android:text="@string/login_splash_text2"
            android:textColor="?vctr_content_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@id/loginSplashText3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/loginSplashPicto2"
            app:layout_constraintTop_toBottomOf="@id/loginSplashText1" />

        <ImageView
            android:id="@+id/loginSplashPicto3"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_login_splash_sliders"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/loginSplashText3"
            app:tint="?vctr_content_secondary"
            tools:ignore="MissingPrefix" />

        <TextView
            android:id="@+id/loginSplashText3"
            style="@style/Widget.Vector.TextView.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="6dp"
            android:gravity="start"
            android:text="@string/login_splash_text3"
            android:textColor="?vctr_content_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/loginSplashPicto3"
            app:layout_constraintTop_toBottomOf="@id/loginSplashText2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Space
        android:id="@+id/loginSplashSpace4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/loginSplashSubmit"
        app:layout_constraintTop_toBottomOf="@id/loginSplashFeatures"
        app:layout_constraintVertical_weight="0" />

    <Button
        android:id="@+id/loginSplashSubmit"
        style="@style/Widget.Vector.Button.Login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:minHeight="40dp"
        android:textAllCaps="true"
        android:transitionName="loginSubmitTransition"
        app:layout_constraintBottom_toTopOf="@id/loginSplashAlreadyHaveAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginSplashSpace4"
        tools:text="@string/login_splash_create_account" />

    <Button
        android:id="@+id/loginSplashAlreadyHaveAccount"
        style="@style/Widget.Vector.Button.Text.Login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:minHeight="32dp"
        android:text="@string/login_splash_already_have_account"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:transitionName="loginSubmitTransition"
        app:layout_constraintBottom_toTopOf="@id/loginSplashSpace5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginSplashSubmit" />

    <Space
        android:id="@+id/loginSplashSpace5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loginSplashAlreadyHaveAccount"
        app:layout_constraintVertical_weight="0" />

    <TextView
        android:id="@+id/loginSplashVersion"
        style="@style/Widget.Vector.TextView.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        android:textColor="?vctr_content_secondary"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_debug_icon"
        app:drawableTint="?colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="@string/settings_version"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
